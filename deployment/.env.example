# Env for startup in docker container

# PYTHON_IMAGE_VARIANT=slim-bookworm

APP_ENV=dev
LOG_LEVEL=DEBUG
# LOG_TO_FILE=true  # optional; default: dev=true, prod/test=false

API_DEBUG=False
API_HOST=0.0.0.0
API_PORT=8000
APP_PORT_OUTSIDE=8000

JWT_SECRET_KEY=super-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

DB_NAME=openshelf
DB_USER=user
DB_PASSWORD=password
DB_PORT_OUTSIDE=5432

DB_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@database:5432/${DB_NAME}
DB_DEBUG=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600